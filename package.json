{
  "name": "helm-anything",
  "version": "1.0.0",
  "packageManager": "pnpm@10.25.0",
  "description": "Helm command templates for quick service deployment",
  "author": "",
  "license": "ISC",
  "keywords": [
    "helm",
    "kubernetes",
    "deployment"
  ],
  "main": "index.js",
  "scripts": {
